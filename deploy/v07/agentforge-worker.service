[Unit]
Description=AgentForge Django trusted one-shot worker (candidate-only)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=agentforge
Group=agentforge
WorkingDirectory=/opt/agentforge/AgentForge
Environment=DJANGO_SETTINGS_MODULE=config.v07_worker_settings
EnvironmentFile=/etc/agentforge/v07-worker.env
# Reject task intake before the worker touches any user project.
# This is a READ-ONLY preflight; no migrations, image pull or paid API calls.
ExecStartPre=/opt/agentforge/venv/bin/python /opt/agentforge/AgentForge/examples/django_host/manage.py check_agentforge_worker --mode dedicated --json
ExecStart=/opt/agentforge/venv/bin/python /opt/agentforge/AgentForge/examples/django_host/manage.py process_agentforge_supervised_queue --mode dedicated --timeout-seconds 780 --include-autonomous
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
TimeoutStartSec=960
TimeoutStopSec=30
KillMode=control-group
SendSIGKILL=yes
Restart=no
UMask=0077

# WARNING: The Docker daemon user/group provides host-level privilege on
# this worker VM. Protect the VM itself. Do not install on the public web host.
