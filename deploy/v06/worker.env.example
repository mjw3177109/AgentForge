# Configuration example only, NEVER put a real key in this file.
# Run on a separate trusted VM; do not expose Docker to Django Web.
AGENTFORGE_WORKER_ROLE=trusted-dedicated
AGENTFORGE_V06_ENABLE_WORKER=I_ACCEPT_DEDICATED_WORKER
AGENTFORGE_ALLOWED_ROOTS=/srv/agentforge-workspaces
DJANGO_SECRET_KEY=REPLACE_WITH_SECURE_VALUE_FROM_SECRET_MANAGER
AGENTFORGE_LLM_BASE_URL=https://api.deepseek.com
AGENTFORGE_LLM_MODEL=deepseek-chat
AGENTFORGE_LLM_API_KEY=SUPPLY_FROM_SECRET_MANAGER_NOT_FROM_THIS_FILE
