# This is a development verifier image; pin FROM by digest in production.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m pip install --no-cache-dir "Django>=4.2,<6"

WORKDIR /workspace
USER 65534:65534
CMD ["python", "--version"]
